# ==============================================================================
# Qjo AI Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Providers (المزودات المعتمدة - مجانية وسريعة)
# ------------------------------------------------------------------------------

# [1] Groq (المزود الأساسي الفائق السرعة)
# يدعم تدوير المفاتيح مفصولة بفواصل: key1,key2
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_API_KEYS=
# نماذج Groq الرسمية الحديثة (بديلة Llama المتوقفة):
GROQ_FLASH_MODEL=openai/gpt-oss-20b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# [2] LLM7 (تجميع مجاني لنماذج الذكاء الاصطناعي - llm7.io)
# يمكنك تركه فارغاً أو وضع توكن مجاني من llm7.io لزيادة حدود الاستخدام
LLM7_API_KEY=
LLM7_API_KEYS=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_FLASH_MODEL=deepseek-chat
LLM7_TEXT_MODEL=llama-3.3-70b-instruct

# [3] Kimi / Moonshot (الخطة المجانية)
KIMI_API_KEY=
KIMI_API_KEYS=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_FLASH_MODEL=moonshot-v1-8k
KIMI_TEXT_MODEL=moonshot-v1-8k
KIMI_CODE_MODEL=moonshot-v1-8k

# [4] Alibaba Qwen / DashScope (الخطة المجانية - تفوق في اللغة العربية)
QWEN_API_KEY=
QWEN_API_KEYS=
QWEN_FLASH_MODEL=qwen-plus
QWEN_TEXT_MODEL=qwen-plus
QWEN_CODE_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus

# ------------------------------------------------------------------------------
# 2. Web Search & Deep Search (محركات البحث وقراءة المواقع)
# ------------------------------------------------------------------------------
# محرك البحث الذكي (Tavily)
TAVILY_API_KEY=

# قراءة محتوى صفحات الويب العميقة (Firecrawl - اختياري)
FIRECRAWL_API_KEY=

# ملاحظة: محرك DuckDuckGo مدمج تلقائياً مجاناً بدون الحاجة لأي مفتاح كشبكة أمان!

# ------------------------------------------------------------------------------
# 3. Embeddings & File RAG (تضمين ملفات الـ PDF والبحث الموجه)
# ------------------------------------------------------------------------------
# اختياري: إذا تُركت فارغة يعتمد Qjo تلقائياً على المحرك المحلي (Local Hashing) بدون مفاتيح
EMBEDDING_API_KEYS=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

HUGGINGFACE_API_KEYS=
HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# ------------------------------------------------------------------------------
# 4. Authentication & Limits (تسجيل الدخول والحدود)
# ------------------------------------------------------------------------------
REQUIRE_FIREBASE_AUTH=true
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# حدود الاستخدام اليومية (0 = غير محدود)
DAILY_USER_LIMIT=0
GUEST_DAILY_LIMIT=0
IP_RATE_LIMIT_PER_MINUTE=0

# البريد الإداري للوصول للوحة الإدارة
ADMIN_EMAILS=your@email.com
EXPORT_MAX_UPLOAD_MB=10
