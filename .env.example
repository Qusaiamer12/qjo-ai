# 1) Groq — primary & fastest provider (free tier)
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: enables Deep Search Engine
TAVILY_API_KEY=tvly_your_tavily_key_here

# Optional production auth verification
REQUIRE_FIREBASE_AUTH=true
# QJO_PUBLIC_TESTING_NOTE: set REQUIRE_FIREBASE_AUTH=false only for temporary open testing, never for production.
DAILY_USER_LIMIT=0
GUEST_DAILY_LIMIT=0
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Admin dashboard
ADMIN_EMAILS=your@email.com
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: multiple Groq keys separated by commas for automatic rotation/fallback
GROQ_API_KEYS=
IP_RATE_LIMIT_PER_MINUTE=0

# Reverse-proxy hop count for X-Forwarded-For. Leave unset: it resolves to 1 on
# Render (auto-detected via the RENDER env var) and 0 for direct/local runs.
# Set explicitly ONLY if the real topology differs, e.g. Cloudflare -> Render = 2.
# Too high a value lets clients forge their IP and bypass per-IP quotas; too low
# collapses every visitor onto the proxy's IP.
# TRUST_PROXY=1


# Model overrides. NOTE: llama-3.1-8b-instant & llama-3.3-70b-versatile are
# deprecated and shut down 2026-08-16 — these are Groq's official replacements
# (older values are auto-migrated at runtime, but update them anyway).
GROQ_FLASH_MODEL=openai/gpt-oss-20b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct


# ── Free-only provider policy (4 providers) ──
# 2) LLM7.io — free OpenAI-compatible aggregator. Works KEYLESS (~30 RPM);
#    a free token from token.llm7.io raises the rate limit. LLM7_ENABLED=false
#    removes it from the chain entirely.
LLM7_ENABLED=true
LLM7_API_KEYS=
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_FLASH_MODEL=llama-3.3-70b-instruct
LLM7_TEXT_MODEL=deepseek-chat


# 4) Qwen — free-quota fallback, strongest Arabic + code + vision
QWEN_API_KEYS=sk_your_qwen_key_here
QWEN_FLASH_MODEL=qwen-plus
QWEN_TEXT_MODEL=qwen-plus
QWEN_CODE_MODEL=qwen-plus


## FINAL ROUTER: Groq primary + Qwen fallback

This build intentionally uses:

```text
GROQ_API_KEYS=gsk_...
QWEN_API_KEYS=...
```

Order:

```text
Groq -> Qwen
```

Gemini is intentionally not used in this final build.


# ── Dormant providers (parsed but OUT of every chain per the free-only ──
# ── policy; setting keys has no effect until re-enabled in RoutingEngine) ──
NVIDIA_API_KEYS=
NVIDIA_FLASH_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct

# OpenRouter (dormant — out of chain under the free-only policy)
OPENROUTER_API_KEYS=
OPENROUTER_FREE_MODELS=qwen/qwen3-235b-a22b:free,meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-7b-instruct:free

# Agnes AI (dormant — out of chain under the free-only policy)
AGNES_API_KEYS=
AGNES_BASE_URL=https://YOUR_AGNES_OPENAI_COMPATIBLE_BASE_URL/v1
AGNES_MODEL=YOUR_AGNES_MODEL


# Optional: strengthens Deep Search by extracting page contents
FIRECRAWL_API_KEY=fc_your_firecrawl_key_here


# 3) Kimi / Moonshot — free slot pinned to moonshot-v1-8k on the official
#    international endpoint (deliberately NOT the paid kimi-k2.* generation)
KIMI_API_KEYS=sk-your_kimi_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_FLASH_MODEL=kimi-k2.6
KIMI_TEXT_MODEL=kimi-k2.6
KIMI_CODE_MODEL=kimi-k2.7-code


# Optional real embeddings for File RAG v2+ (OpenAI-compatible / embeddings endpoint)
# If empty, Qjo falls back to local hashed-vector retrieval.
EMBEDDING_API_KEYS=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small


# Optional: Serper.dev — Google Search results (free tier: 2,500 one-time credits).
# Qjo always pins gl=jo + auto hl=ar/en. Chain: Tavily → Serper → DDG(key-free,
# always-on safety net, so search NEVER dies even with zero paid keys).
SERPER_API_KEY=

# Vision slots (image questions route here first; leave empty to disable)
QWEN_VISION_MODEL=qwen-vl-plus
NVIDIA_VISION_MODEL=

# Hugging Face embeddings support (recommended for Arabic/multilingual RAG if using HF key)
# Set EMBEDDING_PROVIDER=huggingface and put your hf_ token here.
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_API_KEYS=
HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Optional custom HF endpoint, leave empty by default:
HUGGINGFACE_EMBEDDING_URL=


# ── Qjo Knowledge Base (Q-KB v1) ──
# Curated Arabic task-craft guidance injected into the system prompt.
# Works with ZERO setup: without QDRANT_URL the KB uses an in-process vector
# index (entries embedded once per process). To move it to Qdrant Cloud:
#   1) create a free cluster at cloud.qdrant.io
#   2) set QDRANT_URL + QDRANT_API_KEY below (or in Render)
#   3) run: npm run kb:sync
# Set QKB_ENABLED=false to disable the KB entirely.
QKB_ENABLED=true
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_KB_COLLECTION=qjo_kb_v1

# Q-Spark and Qcode moved to their own repositories (qspark-ai / qcode-ai) and
# are not part of this build. Their QSPARK_* / QCODE_* variables now live there;
# see docs/MIGRATION_QSPARK_QCODE.md.

# Max upload size for /api/export/image-to-pdf
EXPORT_MAX_UPLOAD_MB=10
